# Server Configuration
PORT=3000
HOST=0.0.0.0

# Bot Default Settings
AUTO_REPLY_HI=true
REPLY_MESSAGE="Hi there! 👋 How can I help you today?"
BLOCK_INSTAGRAM=true
BLOCK_TIKTOK=true
DELETE_OFFENDING_LINKS=true
WARN_USER=true
DEFAULT_WARNING_MESSAGE="⚠️ @{user}, posting Instagram or TikTok links is not allowed in this group!"

# Local On-Device AI Microservice (Janus 1.3B & Qwen 2.5 - No API Key Required)
# For single instance: http://127.0.0.1:5005
# For two-instance setup: http://<AI_INSTANCE_PRIVATE_IP>:5005
AI_SERVICE_URL=http://127.0.0.1:5005
AI_ENABLED_DEFAULT=true
AI_IMAGE_GEN_DEFAULT=true
